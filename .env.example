# ==============================================================================
# CoursePilot Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   - server/.env for backend service execution
#   - client/.env for frontend Vite application execution
#
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (server/.env)
# ------------------------------------------------------------------------------
# Port the Express server listens on locally
PORT=5000

# Node execution environment: 'development', 'test', or 'production'
NODE_ENV=development

# MongoDB Atlas connection string (Never expose to client!)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/coursepilot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/coursepilot?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens (Never expose to client!)
# Generate a cryptographically secure random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Allowed frontend origin for Cross-Origin Resource Sharing (CORS) with credentials
# Local development default: http://localhost:5173
# Production example: https://coursepilot.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration (client/.env)
# ------------------------------------------------------------------------------
# Base URL for the Express backend API
# Local development default: http://localhost:5000
# Production example: https://coursepilot-api.onrender.com
VITE_API_URL=http://localhost:5000
