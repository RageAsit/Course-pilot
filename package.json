{
  "name": "coursepilot-root",
  "version": "1.0.0",
  "private": true,
  "description": "CoursePilot - Academic Planning & Deadline Prioritization SaaS",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "test:server": "npm run test --workspace=server",
    "build:client": "npm run build --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
